PROJECT_NAME="IT Blog API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL) - mật khẩu 123456, database it_blog
DATABASE_URL=postgresql://postgres:123456@localhost:5432/it_blog

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security / JWT Configuration
SECRET_KEY=supersecretjwtkey_itblog_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# First Admin Seed Data
FIRST_SUPERUSER_EMAIL=admin@itblog.dev
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=AdminPassword123!

# Gemini Interactions API. Use GEMINI_API_KEY for one key or GEMINI_API_KEYS for a comma-separated pool.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
