# Your actual domain (replace with your real domain)
CORS_ORIGINS=

# Tell the frontend to use relative path so it works on any domain
VITE_API_URL=/api/v1

# Master secret key (replace with your own 64-character random string)
SECRET_KEY=

# Database
POSTGRES_PASSWORD=
DATABASE_URL=

# Gemini AI (optional)
GEMINI_API_KEY=your_key_here