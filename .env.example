# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH NHANH (QUICK SETUP)
# ==============================================================================
# 1. GEMINI API KEY:
#    Lấy key miễn phí tại: https://aistudio.google.com/apikey
#    Dán key vào biến GEMINI_API_KEY dưới đây (hoặc GEMINI_API_KEYS nếu có nhiều key).
# ==============================================================================

# Gemini AI API Keys (Hỗ trợ 1 key hoặc nhiều key cách nhau bằng dấu phẩy)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Cấu hình Database PostgreSQL (mặc định cho pgAdmin local, pass 123456, db: it_blog)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/it_blog

# Cấu hình Redis (Tùy chọn cho cache)
REDIS_URL=redis://localhost:6379/0

# Cấu hình bảo mật JWT
SECRET_KEY=supersecretjwtkey_itblog_2026_dev_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cấu hình CORS Frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Tài khoản Admin mặc định để test
FIRST_SUPERUSER_EMAIL=admin@itblog.dev
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=AdminPassword123!

