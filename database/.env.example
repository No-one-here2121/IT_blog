// Cau hinh ket noi PostgreSQL - dung bien moi truong, KHONG hardcode pass vao code.
// File mau: copy thanh .env va sua lai cho dung may cua ban.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=it_blog
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Chuoi ket noi day du (tien cho psql / tool khac)
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/it_blog

# AI / search credentials (never commit real values)
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id
